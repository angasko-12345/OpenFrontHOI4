{
  "name": "OpenFront HOI4",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "containerEnv": { "SKIP_BROWSER_OPEN": "true" },
  "postCreateCommand": "npm i -g npm@12 && npm run inst",
  "postAttachCommand": { "dev": "npm run dev" },
  "forwardPorts": [9000],
  "portsAttributes": {
    "9000": { "label": "Game", "onAutoForward": "openBrowser" },
    "3000": { "onAutoForward": "silent" },
    "3001": { "onAutoForward": "silent" },
    "3002": { "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
